# --- Scanner API (Guild integration sends it as X-AEGIS-Key) ---
SCANNER_KEY=        # openssl rand -hex 24
# --- GitHub (scanner creates issues itself only in fallback mode) ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# --- OpenAI (fallback analyst, used when Guild is not configured) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# --- Guild.ai API trigger (preferred analyst) ---
GUILD_OWNER=
GUILD_WORKSPACE=
GUILD_TRIGGER_KEY=      # "<api_key_id>:<api_key_secret>"
# optional: override which Guild agent runs, e.g. andriidrok1~aegis-analyst
GUILD_AGENT_ID=
# --- ClickHouse (fleet memory: scans / findings / actions). Leave CLICKHOUSE_HOST empty to run without it ---
# Local docker (docker compose -f clickhouse/docker-compose.yml up -d):
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=aegis
CLICKHOUSE_SECURE=0
# ClickHouse Cloud (service -> Connect -> HTTPS; password from the Cloud console):
# CLICKHOUSE_HOST=xxxx.us-east-1.aws.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_SECURE=1
# --- GitHub code scanning: upload every scan's findings to the repo's Security tab (needs GITHUB_TOKEN with repo/security_events) ---
AEGIS_SARIF=0
