# OBSOLETE (R3, 2026-10-09). `sub_agents:` in guild.yaml is only for Goose / Native / OpenClaw / LangGraph agents;
# docs.guild.ai/guide/guild-yaml: "TypeScript agents don't use guild.yaml. They declare tools in code."
# For our GUILD_TYPESCRIPT sentinel the sub-agents are npm dependencies imported from their `/tool` sub-package:
#   npm install --save @guildai/__OWNER__~aegis-triage @guildai/__OWNER__~aegis-remediator @guildai/__OWNER__~aegis-verifier
#   import triageTool from "@guildai/__OWNER__~aegis-triage/tool"   →   tools: { aegis_triage: triageTool, ... }
